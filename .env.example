# --- Which AI service answers customer messages: openai or anthropic ---
AI_PROVIDER=openai

# --- OpenAI (used when AI_PROVIDER=openai) ---
# Get your key at https://platform.openai.com -> API keys
OPENAI_API_KEY=
# gpt-4o is the tested default: it correctly says "let me check with staff" for services
# the info sheet doesn't mention, instead of wrongly denying them (which loses clients bookings).
# gpt-4o-mini is ~15x cheaper but gets that wrong sometimes - only use it if you also list
# every "we don't offer X" explicitly in the business profile.
OPENAI_MODEL=gpt-4o

# --- Anthropic (used when AI_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- Only needed when connecting a real WhatsApp number (Meta Cloud API) ---
# Permanent access token from a Meta "System User"
WHATSAPP_TOKEN=
# Any secret string you choose; enter the same value in Meta's webhook setup form
WHATSAPP_VERIFY_TOKEN=my-secret-verify-token

# Timezone the businesses operate in - lets the bot know if it's currently open or closed
BUSINESS_TIMEZONE=Asia/Karachi

# Server port
PORT=3010
